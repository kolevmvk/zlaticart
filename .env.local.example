# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Create project at https://sanity.io/manage → New Project → name "zlaticart"
# Dataset: production (Sanity default)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: server-side read token (Sanity project → API → Tokens → Add token → Viewer)
# Required only if content is marked non-public in Sanity
SANITY_API_READ_TOKEN=

# ─── ZlaticArt Admin API ─────────────────────────────────────────────────────
# Server-only values for the mobile admin proxy. Never expose these through
# NEXT_PUBLIC_* variables and never place them in the mobile app bundle.
# Generate ADMIN_PIN_HASH with:
# node -e "const { pbkdf2Sync, randomBytes } = require('node:crypto'); const pin = '123456'; const salt = randomBytes(16); const hash = pbkdf2Sync(pin, salt, 210000, 32, 'sha256'); console.log(`pbkdf2:sha256:210000:${salt.toString('base64url')}:${hash.toString('base64url')}`)"
ADMIN_PIN_HASH=
ADMIN_SESSION_SECRET=
SANITY_API_WRITE_TOKEN=

# ─── Site ─────────────────────────────────────────────────────────────────────
# Change to your actual domain once DNS is live
NEXT_PUBLIC_SITE_URL=https://zlaticart.com
